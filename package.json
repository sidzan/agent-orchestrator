{
  "name": "agent-bootstrap",
  "version": "0.3.0",
  "description": "Bootstrap a project-tailored multi-agent orchestration skill into any React or C# project.",
  "bin": {
    "agent-bootstrap": "bin/bootstrap.js"
  },
  "main": "bin/bootstrap.js",
  "files": [
    "bin/",
    "lib/",
    "templates/",
    "README.md",
    "docs/templating.md"
  ],
  "scripts": {
    "start":                "node bin/bootstrap.js",
    "lint:templates":       "node lib/template-lint.js",
    "test:snapshot":        "node tests/snapshot.js",
    "test:snapshot:update": "node tests/snapshot.js --update",
    "test":                 "npm run lint:templates && npm run test:snapshot"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude",
    "claude-code",
    "skill",
    "agent",
    "orchestration",
    "react",
    "csharp",
    "scaffold"
  ],
  "author": "sidzan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sidzan/agent-bootstrap.git"
  }
}
